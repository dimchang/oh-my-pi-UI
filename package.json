{
  "name": "omp-gui",
  "version": "0.4.20",
  "description": "Windows GUI for oh-my-pi (omp), Codex-style, via omp --mode rpc-ui",
  "main": "out/main/index.js",
  "author": "OMP-UI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder",
    "pack:portable": "electron-vite build && electron-builder --win portable",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0-beta.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.1"
  }
}
